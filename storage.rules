rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Customer Photos: Public read for public showcase, direct writes prohibited (handled via verified admin server endpoints)
    match /customer-photos/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
