DATABASE_URL="mongodb+srv://<user>:<password>@cluster.mongodb.net/adrizo"
ADMIN_EMAIL="Care.adrizo@gmail.com"
ADMIN_PASSWORD="YourAdminPassword"
JWT_SECRET="your-secure-jwt-secret-key"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =========================================================================
# Razorpay Online Payment Gateway Configuration
# Sign in to Razorpay Dashboard (https://dashboard.razorpay.com/) -> Settings -> API Keys
# For local testing, use Test Mode keys (prefix: rzp_test_...)
# =========================================================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Mail / SMTP Configuration
MAIL_FROM="AD(R)IZO <care.adrizo@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=care.adrizo@gmail.com
SMTP_PASS=your_gmail_app_password

# Shiprocket Logistics API Configuration (Server-Side Only - Dedicated API User)
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
